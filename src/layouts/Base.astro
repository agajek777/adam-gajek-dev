---
import "@fontsource-variable/geist";
import "../styles/global.css";
import { EMAIL, GITHUB, LINKEDIN, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page without locale prefix, e.g. "/". */
  path?: string;
  noindex?: boolean;
}

const { locale, title, description, path = "/", noindex = false } = Astro.props;
const site = Astro.site!;
const urlFor = (l: Locale) => new URL(l === "en" ? path : `/pl${path}`, site).href;
const canonical = urlFor(locale);
const ogImage = new URL("/og.png", site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Adam Gajek",
  jobTitle: ".NET Developer",
  email: `mailto:${EMAIL}`,
  url: urlFor("en"),
  address: { "@type": "PostalAddress", addressLocality: "Warsaw", addressCountry: "PL" },
  sameAs: [LINKEDIN, GITHUB],
  knowsAbout: ["C#", ".NET", "Azure", "Microservices", "Distributed systems", "RabbitMQ", "Kafka", "Kubernetes"],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={urlFor("en")} />
    <link rel="alternate" hreflang="pl" href={urlFor("pl")} />
    <link rel="alternate" hreflang="x-default" href={urlFor("en")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1322" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "pl_PL"} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <!-- Apply the stored theme before first paint to avoid a flash. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
