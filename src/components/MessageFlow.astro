---
// Hero illustration: an API publishing messages through RabbitMQ to two consumers.
// Packets travel under the broker box, so they appear to enter and leave the broker.
interface Props {
  label: string;
}

const { label } = Astro.props;

const toA = "M64 66 H222 C250 66 248 29 276 29";
const toB = "M64 66 H222 C250 66 248 103 276 103";
const DURATION = 2.4;
const packets = [0, 1, 2, 3].map((i) => ({ path: i % 2 === 0 ? toA : toB, begin: `${(i * DURATION) / 4}s` }));
---

<svg class="flow" viewBox="0 0 360 132" role="img" aria-label={label}>
  <g class="flow-wires" fill="none">
    <path d="M64 66 H118" />
    <path d="M222 66 C250 66 248 29 276 29" />
    <path d="M222 66 C250 66 248 103 276 103" />
  </g>

  <g class="flow-packets">
    {
      packets.map((p) => (
        <circle r="4" opacity="0">
          <animateMotion dur={`${DURATION}s`} begin={p.begin} repeatCount="indefinite" path={p.path} />
          <animate
            attributeName="opacity"
            dur={`${DURATION}s`}
            begin={p.begin}
            repeatCount="indefinite"
            values="0;1;1;0"
            keyTimes="0;0.08;0.9;1"
          />
        </circle>
      ))
    }
  </g>

  <g class="flow-nodes">
    <g>
      <rect x="0.5" y="51" width="63" height="30" rx="8" />
      <text x="32" y="70.5">API</text>
    </g>
    <g class="flow-broker">
      <rect x="118" y="51" width="104" height="30" rx="8" />
      <text x="170" y="70.5">RabbitMQ</text>
    </g>
    <g>
      <rect x="276" y="14" width="83.5" height="30" rx="8" />
      <text x="317.75" y="33.5">consumer</text>
    </g>
    <g>
      <rect x="276" y="88" width="83.5" height="30" rx="8" />
      <text x="317.75" y="107.5">consumer</text>
    </g>
  </g>
</svg>
